# Gzips the daemon's finished daily sample logs: every
# /var/lib/jackerymon/<serial>/YYYY-MM-DD.jsonl but today's (UTC).  Nothing is
# deleted.  Run daily by jackerymon-compress.timer, which the daemon's
# unit pulls in.
[Unit]
Description=Compress finished jackerymon sample logs

[Service]
Type=oneshot
User=jackerymon
Group=jackerymon
StateDirectory=jackerymon
# As the tmpfiles entry has it; systemd resets the mode at start.
StateDirectoryMode=0755
ExecStart=/usr/bin/jackerymon compress-logs /var/lib/jackerymon
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
