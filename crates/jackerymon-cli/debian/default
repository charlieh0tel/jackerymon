# Options for jackerymon.service.

# Read-only HTTP: web page, metrics, status, events.
#JACKERYMON_LISTEN=127.0.0.1:9888

# Accept settings over TCP too.  No authentication.
#JACKERYMON_TCP_CONTROL=false

# Power-cycle the Bluetooth adapter when a unit goes unfound after a
# failed connect.  Drops every Bluetooth connection on the host.
#JACKERYMON_RESET_ADAPTER=false
