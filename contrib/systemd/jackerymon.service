# Runs `jackerymon daemon`.  Untested; see README.md, "Daemon".
[Unit]
Description=Jackery BLE monitor
Wants=bluetooth.target
After=bluetooth.target

[Service]
User=jackerymon
# BlueZ's D-Bus policy grants device access to this group on many
# distributions; check /etc/dbus-1/system.d/bluetooth.conf on yours.
SupplementaryGroups=bluetooth
ConfigurationDirectory=jackerymon
LogsDirectory=jackerymon
# The socket, /run/jackerymon/<serial>.sock.  Any local user may use it
# for now; groups come with packaging.
RuntimeDirectory=jackerymon
RuntimeDirectoryMode=0755
# Reads its key from /etc/jackerymon/<serial>.json.
ExecStart=/usr/local/bin/jackerymon daemon --log-dir /var/log/jackerymon
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
# The per-unit lock, shared with interactive commands.
ReadWritePaths=/run/lock
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
